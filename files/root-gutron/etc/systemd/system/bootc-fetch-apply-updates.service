# Service patched for a headless server to apply updates at night instead of just queue them up for next reboot periodically

[Unit]
Description=Apply bootc updates
Documentation=man:bootc(8)
ConditionPathExists=/run/ostree-booted

[Service]
Type=oneshot
ExecStart=/usr/bin/bootc update --apply --quiet
# ExecStart=/usr/bin/bootc update --quiet
